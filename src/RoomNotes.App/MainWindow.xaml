<Window
    x:Class="RoomNotes.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:RoomNotes.Core"
    Title="RoomNotes | Local meeting workspace">
    <Grid x:Name="Root" Background="#F5F5F7" Padding="28,22" RowSpacing="18" RequestedTheme="Light" Loaded="OnLoaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="5">
                <TextBlock Text="ROOMNOTES  /  LOCAL MEETING WORKSPACE" Style="{StaticResource Eyebrow}" />
                <TextBlock Text="Conversations become completed forms." FontSize="30" FontWeight="Bold" TextWrapping="Wrap" />
                <TextBlock Text="Capture speech. Find what matters. Review before it leaves the room."
                           FontSize="14" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center" MaxWidth="310">
                <Border Background="#17181F" CornerRadius="8" Padding="12,8">
                    <TextBlock Text="ON-DEVICE INFERENCE  /  NO CLOUD API" Foreground="White" FontWeight="SemiBold" FontSize="11" />
                </Border>
                <Button x:Name="ConnectButton" Content="Reconnect local models" Click="ConnectClicked" HorizontalAlignment="Stretch" />
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12">
            <Grid ColumnSpacing="22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="TemplatePicker" AutomationProperties.AutomationId="TemplatePicker" Header="Form template" DisplayMemberPath="Name"
                          HorizontalAlignment="Stretch" SelectionChanged="TemplateChanged"
                          ToolTipService.ToolTip="Start a new session to change the form template." />
                <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                    <TextBlock x:Name="SpeechStatus" Text="Speech: not connected" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock x:Name="ModelStatus" Text="Analysis: not connected" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="SampleButton" AutomationProperties.AutomationId="SampleButton" Content="Load fictional sample" Click="SampleClicked" />
                    <Button x:Name="NewButton" AutomationProperties.AutomationId="NewButton" Content="New session" Click="NewClicked" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="0.9*" />
                <ColumnDefinition Width="1.05*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock Text="01 / CAPTURE" Style="{StaticResource Eyebrow}" />
                        <TextBlock Text="The conversation" FontSize="23" FontWeight="SemiBold" />
                        <TextBlock Text="English speech, processed in short chunks on this device. Or paste your own transcript."
                                   Style="{StaticResource SmallText}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Spacing="8">
                        <ComboBox x:Name="MicrophonePicker" Header="Microphone" DisplayMemberPath="Name"
                                  HorizontalAlignment="Stretch" PlaceholderText="No microphone detected" />
                        <CheckBox x:Name="ConsentCheck" Content="I have permission to capture this conversation"
                                  Checked="InputStateChanged" Unchecked="InputStateChanged">
                            <CheckBox.ContentTemplate>
                                <DataTemplate><TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" /></DataTemplate>
                            </CheckBox.ContentTemplate>
                        </CheckBox>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="RecordButton" Content="Start microphone" Click="RecordClicked"
                                    Background="{StaticResource AccentBrush}" Foreground="White" />
                            <Button x:Name="StopButton" Content="Stop" Click="StopClicked" IsEnabled="False" />
                            <Button x:Name="ImportButton" Content="WAV" Click="ImportClicked"
                                    ToolTipService.ToolTip="Import a local mono or stereo PCM WAV file." />
                        </StackPanel>
                        <ProgressBar x:Name="AudioLevel" Minimum="0" Maximum="100" Value="0" Height="4"
                                     AutomationProperties.Name="Microphone level" />
                        <TextBlock x:Name="CaptureStatus" Text="Microphone off. Audio is not saved by RoomNotes." Style="{StaticResource SmallText}" />
                    </StackPanel>
                    <TextBox x:Name="TranscriptBox" AutomationProperties.AutomationId="TranscriptBox" Grid.Row="2" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalAlignment="Stretch" VerticalContentAlignment="Top" MinHeight="120" MaxLength="60000"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" TextChanged="TranscriptChanged"
                             PlaceholderText="Your transcript will appear here. No microphone capture begins until you press Start."
                             AutomationProperties.Name="Meeting transcript" FontSize="15" Padding="12" />
                    <StackPanel Grid.Row="3" Spacing="5">
                        <TextBlock x:Name="TranscriptStats" Text="0 words / memory only" Style="{StaticResource SmallText}" />
                        <CheckBox x:Name="AutoAnalyzeCheck" IsChecked="True" Content="Analyze and fill when capture stops" FontSize="12" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <Grid RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock Text="02 / UNDERSTAND" Style="{StaticResource Eyebrow}" />
                        <TextBlock Text="Local analysis" FontSize="23" FontWeight="SemiBold" />
                        <TextBlock Text="Source-backed summary and commitments, plus transcript flags for unfinished reviews. Check every result against the conversation."
                                   Style="{StaticResource SmallText}" />
                    </StackPanel>
                    <Button x:Name="AnalyzeButton" AutomationProperties.AutomationId="AnalyzeButton" Grid.Row="1" Content="Analyze + auto-fill form" Click="AnalyzeClicked"
                            HorizontalAlignment="Stretch" Background="#17181F" Foreground="White" />
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="18" Padding="0,0,8,0">
                            <StackPanel Spacing="6">
                                <TextBlock Text="SOURCE-BACKED SUMMARY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock x:Name="SummaryText" AutomationProperties.AutomationId="SummaryText" Text="Ready when you are. Capture speech or load a fictional sample, then analyze."
                                           TextWrapping="Wrap" FontSize="15" IsTextSelectionEnabled="True" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="AGREED ACTIONS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock x:Name="ActionsText" AutomationProperties.AutomationId="ActionsText" Text="Not analyzed yet" TextWrapping="Wrap" FontSize="14" IsTextSelectionEnabled="True" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="OPEN REVIEWS / TRANSCRIPT FLAGS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                <TextBlock x:Name="RisksText" AutomationProperties.AutomationId="RisksText" Text="Not analyzed yet" TextWrapping="Wrap" FontSize="14" IsTextSelectionEnabled="True" />
                            </StackPanel>
                            <TextBlock x:Name="WarningsText" TextWrapping="Wrap" Foreground="#925700" FontSize="12" />
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="3" Background="#F5F5F7" CornerRadius="8" Padding="10">
                        <TextBlock x:Name="AnalysisStats" Text="No inference has run. No simulated results." Style="{StaticResource SmallText}" />
                    </Border>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock Text="03 / REVIEW + USE" Style="{StaticResource Eyebrow}" />
                        <TextBlock Text="Your completed draft" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="TemplateDescription" Style="{StaticResource SmallText}" />
                        <TextBlock x:Name="FormStats" AutomationProperties.AutomationId="FormStats" Text="No fields filled" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="FormItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="core:FormField">
                                    <StackPanel Spacing="5" Margin="0,0,8,14">
                                        <TextBox AutomationProperties.AutomationId="{x:Bind Definition.Id}" Header="{x:Bind Label}" Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="{x:Bind Hint}" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="1200" />
                                        <TextBlock Text="{x:Bind Provenance, Mode=OneWay}" Style="{StaticResource SmallText}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Spacing="5">
                        <CheckBox x:Name="ReviewCheck" AutomationProperties.AutomationId="ReviewCheck" Content="I reviewed the analysis and all form fields"
                                  Checked="InputStateChanged" Unchecked="InputStateChanged" FontSize="12" />
                        <CheckBox x:Name="IncludeTranscriptCheck" Content="Include full transcript in export" FontSize="12" />
                        <Button x:Name="ExportButton" AutomationProperties.AutomationId="ExportButton" Content="Save reviewed form (.json)" Click="ExportClicked" HorizontalAlignment="Stretch" />
                        <TextBlock Text="No automatic submission. Export locations may sync to cloud storage."
                                   Style="{StaticResource SmallText}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <StackPanel Grid.Row="3" Spacing="8">
            <InfoBar x:Name="Notice" AutomationProperties.AutomationId="Notice" IsOpen="False" IsClosable="True" Severity="Error" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressRing x:Name="BusyRing" Width="20" Height="20" IsActive="False" />
                <TextBlock x:Name="StatusText" AutomationProperties.AutomationId="StatusText" Grid.Column="1" Text="Starting local workspace..." VerticalAlignment="Center"
                           FontSize="12" TextWrapping="Wrap" />
                <Button x:Name="CancelButton" Grid.Column="2" Content="Cancel operation" Click="CancelClicked" Visibility="Collapsed" />
            </Grid>
        </StackPanel>
    </Grid>
</Window>
